          }
        ],
        "lineageTag": "47ada55b-8e36-55f8-9c73-fc8fe5ee02cb",
        "measures": [
          {
            "name": "Transactions Screened",
            "expression": "COUNTROWS(fact_transactions)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Review Alerts",
            "expression": "COUNTROWS(fact_screening_alerts)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Alert Rate",
            "expression": "DIVIDE([Review Alerts], [Transactions Screened])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "High-Risk Alerts",
            "expression": "CALCULATE([Review Alerts], fact_screening_alerts[risk_score] >= 70)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Average Risk Score",
            "expression": "AVERAGE(fact_transactions[risk_score])",
            "formatString": "0.00",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Total Amount GBP",
            "expression": "SUM(fact_transactions[amount])",
            "formatString": "£#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Average Amount GBP",
            "expression": "AVERAGE(fact_transactions[amount])",
            "formatString": "£#,0.00",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Average Velocity",
            "expression": "AVERAGE(fact_transactions[velocity_1h])",
            "formatString": "0.00",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Velocity Spike Payments",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[velocity_1h] >= 4)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Unusual-Time Payments",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[night] = 1)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening Alerts",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[screening_review] = 1)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening TP",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[screening_review] = 1, fact_transactions[screening_truth] = 1)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening FP",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[screening_review] = 1, fact_transactions[screening_truth] = 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening FN",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[screening_review] = 0, fact_transactions[screening_truth] = 1)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening TN",
            "expression": "CALCULATE([Transactions Screened], fact_transactions[screening_review] = 0, fact_transactions[screening_truth] = 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening Precision",
            "expression": "DIVIDE([Screening TP], [Screening TP] + [Screening FP])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening Recall",
            "expression": "DIVIDE([Screening TP], [Screening TP] + [Screening FN])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening F1",
            "expression": "DIVIDE(2 * [Screening Precision] * [Screening Recall], [Screening Precision] + [Screening Recall])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening FPR",
            "expression": "DIVIDE([Screening FP], [Screening FP] + [Screening TN])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Screening FNR",
            "expression": "DIVIDE([Screening FN], [Screening TP] + [Screening FN])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Open Alerts",
            "expression": "COALESCE(CALCULATE([Review Alerts], fact_screening_alerts[status] = \"OPEN\"), 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "In Review Alerts",
            "expression": "COALESCE(CALCULATE([Review Alerts], fact_screening_alerts[status] = \"IN_REVIEW\"), 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Escalated Alerts",
            "expression": "COALESCE(CALCULATE([Review Alerts], fact_screening_alerts[status] = \"ESCALATED\"), 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Closed Alerts",
            "expression": "COALESCE(CALCULATE([Review Alerts], fact_screening_alerts[status] = \"CLOSED\"), 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Reviewed False Positives",
            "expression": "COALESCE(CALCULATE([Review Alerts], fact_screening_alerts[disposition] = \"FALSE_POSITIVE\"), 0)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Reviewed FP Share",
            "expression": "DIVIDE([Reviewed False Positives], [Closed Alerts])",
            "formatString": "0.00%",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Average Case Age at Cutoff",
            "expression": "AVERAGE(fact_screening_alerts[age_at_data_cutoff_days])",
            "formatString": "0.0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Rule Alerts",
            "expression": "COUNTROWS(bridge_alert_rules)",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "XGBoost Threshold",
            "expression": "CALCULATE(MAX(model_comparison[threshold]), model_comparison[model] = \"XGBoost\")",
            "formatString": "0.00",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Test TP",
            "expression": "CALCULATE(MAX(model_comparison[tp]), model_comparison[model] = \"XGBoost\")",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Test FP",
            "expression": "CALCULATE(MAX(model_comparison[fp]), model_comparison[model] = \"XGBoost\")",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Test FN",
            "expression": "CALCULATE(MAX(model_comparison[fn]), model_comparison[model] = \"XGBoost\")",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Test TN",
            "expression": "CALCULATE(MAX(model_comparison[tn]), model_comparison[model] = \"XGBoost\")",
            "formatString": "#,0",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Cramers V",
            "expression": "MAX(statistical_findings[cramers_v])",
            "formatString": "0.000",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Rank Biserial",
            "expression": "MAX(statistical_findings[rank_biserial])",
            "formatString": "0.000",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
          },
          {
            "name": "Spearman Rho",
            "expression": "MAX(statistical_findings[spearman_rho])",
            "formatString": "0.000",
            "displayFolder": "FinCrimeAI",
            "description": "Synthetic simulation; human review remains final."
