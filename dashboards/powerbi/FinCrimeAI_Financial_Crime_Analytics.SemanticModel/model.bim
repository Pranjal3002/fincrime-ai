        "partitions": [
          {
            "name": "fact_transactions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_transactions.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"transaction_id\", type text}, {\"customer_key\", Int64.Type}, {\"counterparty_key\", Int64.Type}, {\"date_key\", Int64.Type}, {\"origin_geography_key\", Int64.Type}, {\"destination_geography_key\", Int64.Type}, {\"channel_key\", Int64.Type}, {\"risk_key\", Int64.Type}, {\"timestamp\", type datetime}, {\"amount\", type number}, {\"currency\", type text}, {\"payment_type\", type text}, {\"payment_category\", type text}, {\"originating_bank\", type text}, {\"network\", type text}, {\"beneficiary_bank\", type text}, {\"status\", type text}, {\"risk_score\", Int64.Type}, {\"model_probability\", type number}, {\"screening_score\", type number}, {\"alert_flag\", Int64.Type}, {\"rule_reasons\", type text}, {\"investigation_label\", Int64.Type}, {\"screening_truth\", Int64.Type}, {\"velocity_1h\", Int64.Type}, {\"amount_ratio\", type number}, {\"night\", Int64.Type}, {\"new_counterparty\", Int64.Type}, {\"recommendation\", type text}, {\"hour_utc\", Int64.Type}, {\"screening_review\", Int64.Type}, {\"screening_score_band\", Int64.Type}, {\"amount_band\", type text}}, \"en-GB\")",
                "in",
                "    Types"
              ]
